#include <winres.h>
#include <CyGameCaptureCore/Version.hpp>
#include "CyGameCaptureIcon.rc2"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CYGC_VERSION_MAJOR,CYGC_VERSION_MINOR,CYGC_VERSION_PATCH,0
 PRODUCTVERSION CYGC_VERSION_MAJOR,CYGC_VERSION_MINOR,CYGC_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Cyberalien"
            VALUE "FileDescription",  "CyGameCaptureOBS - OBS Studio source and multi-buffer recorder for CyGameCapture streams"
            VALUE "FileVersion",      CYGC_VERSION_STRING
            VALUE "LegalCopyright",   CYGC_LEGAL_COPYRIGHT
            VALUE "InternalName",     "CyGameCaptureOBS"
            VALUE "OriginalFilename", "CyGameCaptureOBS.dll"
            VALUE "ProductName",      "CyGameCapture"
            VALUE "ProductVersion",   CYGC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
