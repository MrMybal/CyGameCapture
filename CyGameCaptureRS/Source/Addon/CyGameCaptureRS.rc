#include <winres.h>
#include <CyGameCaptureCore/Version.hpp>
#include "CyGameCaptureIcon.rc2"

// The logo the overlay draws; decoded once with WIC, then uploaded as an ordinary texture.
IDR_CYGAMECAPTURE_LOGO RCDATA "CyGameCapture_Logo_256.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CYGC_VERSION_MAJOR,CYGC_VERSION_MINOR,CYGC_VERSION_PATCH,0
 PRODUCTVERSION CYGC_VERSION_MAJOR,CYGC_VERSION_MINOR,CYGC_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Cyberalien"
            VALUE "FileDescription",  "CyGameCaptureRS - ReShade GPU buffer inspector and Spout2 capture add-on"
            VALUE "FileVersion",      CYGC_VERSION_STRING
            VALUE "LegalCopyright",   CYGC_LEGAL_COPYRIGHT
            VALUE "InternalName",     "CyGameCaptureRS"
            VALUE "OriginalFilename", "CyGameCaptureRS.addon64"
            VALUE "ProductName",      "CyGameCapture"
            VALUE "ProductVersion",   CYGC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
